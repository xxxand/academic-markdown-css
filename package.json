{
  "name": "academic-markdown-css",
  "version": "0.1.0",
  "private": true,
  "description": "Chinese-first A4 academic PDF themes for md-to-pdf, with light, night, and monochrome palettes, Noto Serif SC / Noto Sans SC, Sarasa Mono SC, Mermaid, KaTeX, alerts, and diff highlighting.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxxand/academic-markdown-css.git"
  },
  "homepage": "https://github.com/xxxand/academic-markdown-css",
  "bugs": {
    "url": "https://github.com/xxxand/academic-markdown-css/issues"
  },
  "scripts": {
    "render": "md-to-pdf --config-file md-to-pdf.config.js",
    "render:night": "md-to-pdf --config-file md-to-pdf.night.config.js",
    "render:mono": "md-to-pdf --config-file md-to-pdf.mono.config.js",
    "render:all": "node scripts/render.js",
    "build": "md-to-pdf example.md --config-file md-to-pdf.config.js",
    "build:night": "node scripts/build-night.js",
    "build:mono": "node scripts/build-mono.js",
    "build:all": "npm run build && npm run build:night && npm run build:mono",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "node scripts/verify.js",
    "verify:examples": "node scripts/verify.js --expect-katex example.pdf example-night.pdf example-mono.pdf"
  },
  "keywords": [
    "markdown",
    "css",
    "pdf",
    "md-to-pdf",
    "academic",
    "typesetting",
    "cjk",
    "chinese-typography",
    "a4",
    "print-css",
    "puppeteer",
    "mermaid",
    "katex",
    "light-theme",
    "dark-theme",
    "monochrome",
    "alerts",
    "diff"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "highlight.js": "11.12.0",
    "katex": "0.16.47",
    "marked": "18.1.2",
    "marked-katex-extension": "5.1.13",
    "md-to-pdf": "5.2.5",
    "mermaid": "11.17.2",
    "puppeteer": "25.15.0"
  },
  "overrides": {
    "md-to-pdf": {
      "marked": "18.1.2",
      "puppeteer": "25.15.0"
    }
  },
  "license": "MIT"
}
